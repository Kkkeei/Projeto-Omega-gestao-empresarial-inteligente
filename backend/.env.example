# Configuração local do backend ÔMEGA (copie para .env e preencha os segredos).
OMEGA_ENV=development
OMEGA_ADMIN_NAME=Administrador Local
OMEGA_ADMIN_EMAIL=admin@omega.local
OMEGA_ADMIN_PASSWORD=ALTERE-ESTA-SENHA
OMEGA_JWT_SECRET=DEFINA-UM-SEGREDO-ALEATORIO-COM-PELO-MENOS-32-CARACTERES
OMEGA_CERTIFICADO_MASTER_KEY=GERE-UMA-CHAVE-FERNET-VALIDA

# Em desenvolvimento, localhost/127.0.0.1 e IPs privados na porta 5173
# também são aceitos para acesso ao Vite pela rede local.
# Separe origens extras por vírgula; não use aspas em torno de cada origem.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OMEGA_RESET_EXPOSE_URL=false
OMEGA_SYNC_ON_STARTUP=false
