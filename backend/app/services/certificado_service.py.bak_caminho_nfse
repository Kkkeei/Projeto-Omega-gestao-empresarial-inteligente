
from __future__ import annotations

from typing import Any

from app.modules.certificados import service as repository
from app.db.database import conectar_banco, STORAGE_BASE


class CertificateService:
    """Façade única para módulos consumidores.

    NFS-e/SEFAZ/eSocial não devem acessar storage, PFX, PC/SC, PKCS#11 ou PIN.
    Esta camada expõe apenas identidade, validação, uso e assinatura futura.
    """

    def get(self, certificado_id: int) -> dict[str, Any]:
        return repository.obter(certificado_id)

    def get_for_company(self, empresa_id: int, tipo: str | None = None) -> list[dict[str, Any]]:
        return repository.listar(empresa_id, tipo)

    def get_for_pf(self, pessoa_id: int, tipo: str | None = None) -> list[dict[str, Any]]:
        return repository.listar_pf_por_pessoa(pessoa_id, tipo)

    def identity_pf(self, certificado_id: int) -> dict[str, Any]:
        cert = repository.obter_pf(certificado_id)
        if not cert["apto_para_uso"] or cert["status"] != "ATIVO":
            raise ValueError("O certificado PF não está apto para uso.")
        return {
            "certificado_id": cert["id"],
            "pessoa_id": cert["pessoa_id"],
            "tipo": cert["tipo"],
            "titular": cert["nome_titular"],
            "documento": cert["documento_titular"],
            "emissor": cert["emissor"],
            "numero_serie": cert["numero_serie"],
            "thumbprint_sha256": cert["thumbprint_sha256"],
            "validade": cert["data_validade"],
        }

    def validate_for_use(self, certificado_id: int) -> dict[str, Any]:
        cert = repository.obter(certificado_id)
        if not cert["apto_para_uso"]:
            raise ValueError("O certificado não está apto para uso.")
        if cert["status"] != "ATIVO":
            raise ValueError("O certificado não está ativo.")
        return cert

    def record_usage(self, certificado_id: int, modulo: str, origin: str = "PJ") -> None:
        if origin.upper() == "PF":
            repository.registrar_uso_pf(certificado_id, modulo)
        else:
            repository.registrar_uso(certificado_id, modulo)

    def a1_mtls_files(self, certificado_id: int, origin: str):
        return a1_mtls_files(certificado_id, origin)

    def identity(self, certificado_id: int) -> dict[str, Any]:
        cert = self.validate_for_use(certificado_id)
        return {
            "certificado_id": cert["id"],
            "empresa_id": cert["empresa_id"],
            "tipo": cert["tipo"],
            "titular": cert["nome_titular"],
            "documento": cert["documento_titular"],
            "emissor": cert["emissor"],
            "numero_serie": cert["numero_serie"],
            "thumbprint_sha256": cert["thumbprint_sha256"],
            "validade": cert["data_validade"],
        }


certificate_service = CertificateService()

# ---------------------------------------------------------------------------
# Recursos controlados para consumidores fiscais (ex.: NFS-e)
# ---------------------------------------------------------------------------
from contextlib import contextmanager
import os as _os
import tempfile as _tempfile
from pathlib import Path as _Path
from cryptography.hazmat.primitives.serialization import NoEncryption as _NoEncryption, PrivateFormat as _PrivateFormat, Encoding as _Encoding
from cryptography.hazmat.primitives.serialization import pkcs12 as _pkcs12
from app.modules.certificados.service import _decrypt


def _get_pf_row(certificado_id: int) -> dict[str, Any]:
    with conectar_banco() as conn:
        row = conn.execute("SELECT * FROM certificados_pf WHERE id=?", (certificado_id,)).fetchone()
    if not row:
        raise LookupError("Certificado PF não encontrado.")
    return dict(row)


def _get_a1_storage_row(certificado_id: int, origin: str) -> dict[str, Any]:
    if origin == "PJ":
        with conectar_banco() as conn:
            row = conn.execute("SELECT * FROM certificados WHERE id=? AND tipo='A1'", (certificado_id,)).fetchone()
    else:
        row = _get_pf_row(certificado_id)
        if row.get("tipo") != "A1":
            row = None
    if not row:
        raise LookupError("Certificado A1 não encontrado.")
    return dict(row)


@contextmanager
def a1_mtls_files(certificado_id: int, origin: str):
    """Expose an A1 certificate as short-lived PEM files for mTLS consumers.

    The files are created only for the duration of the request and removed in
    the finally block. The database/storage keeps the original encrypted PFX.
    """
    origin = origin.upper()
    row = _get_a1_storage_row(certificado_id, origin)
    if row.get("status") != "ATIVO" or not row.get("apto_para_uso"):
        raise ValueError("O certificado A1 não está ativo e apto para uso.")
    ref = row.get("storage_ref")
    if not ref:
        raise ValueError("O certificado A1 não possui armazenamento disponível.")
    ref_path = _Path(str(ref))
    if ref_path.is_absolute() or ".." in ref_path.parts:
        raise ValueError("Referência de armazenamento do certificado A1 inválida.")
    path = STORAGE_BASE / "certificados" / ref_path
    if not path.is_file():
        # PF/PJ storage_ref normalmente já é relativo ao diretório certificados.
        alt = STORAGE_BASE / str(ref)
        path = alt if alt.is_file() else path
    if not path.is_file():
        raise FileNotFoundError("Arquivo criptografado do certificado A1 não encontrado.")
    pwd_path = path.with_suffix(".pwd.enc")
    if not pwd_path.is_file():
        raise FileNotFoundError("Senha criptografada do certificado A1 não encontrada.")
    pfx = _decrypt(path.read_bytes())
    password = _decrypt(pwd_path.read_bytes()).decode("utf-8")
    private_key, cert, _extras = _pkcs12.load_key_and_certificates(pfx, password.encode("utf-8"))
    if private_key is None or cert is None:
        raise ValueError("O A1 não contém chave privada/certificado válidos.")

    with _tempfile.TemporaryDirectory(prefix="omega_nfse_a1_") as td:
        td_path = _Path(td)
        cert_file = td_path / "client.crt.pem"
        key_file = td_path / "client.key.pem"
        cert_file.write_bytes(cert.public_bytes(_Encoding.PEM))
        key_file.write_bytes(private_key.private_bytes(_Encoding.PEM, _PrivateFormat.TraditionalOpenSSL, _NoEncryption()))
        try:
            _os.chmod(cert_file, 0o600)
            _os.chmod(key_file, 0o600)
        except OSError:
            pass
        yield cert_file, key_file
