# Token compartilhado entre o navegador e o OMEGA Bridge.
# Gere um valor aleatório longo e mantenha-o fora do Git.
OMEGA_BRIDGE_TOKEN=

# Origens que podem chamar o Bridge. Inclua a URL usada para abrir o frontend.
# Ex.: http://192.168.0.131:5173
OMEGA_BRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Caminho completo para a biblioteca PKCS#11 do middleware do cartão/token.
# Windows: C:\\Program Files\\...\\arquivo.dll
# Linux: /usr/lib/.../arquivo.so
OMEGA_PKCS11_MODULE=

# Destinos HTTPS permitidos para consultas NFS-e com A3 via certificado do Windows
OMEGA_BRIDGE_ALLOWED_NFSE_HOSTS=adn.nfse.gov.br,adn.producaorestrita.nfse.gov.br,sefin.nfse.gov.br,sefin.producaorestrita.nfse.gov.br
