# ÔMEGA - configuração local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.3:5173
# Nunca sincronizar 46 empresas no boot por padrão.
OMEGA_SYNC_ON_STARTUP=false
BRASILAPI_MAX_RETRIES=3
BRASILAPI_TIMEOUT=20
BRASILAPI_INTERVAL_SECONDS=2
# As automações PyAutoGUI fecham o Chrome ao terminar.
OMEGA_CLOSE_CHROME_HARD=true
SEFAZ_CERTIFICADO_NOME=OMEGA CONTABILIDADE
RFB_ACCEPT_COOKIES=true
RFB_COOKIE_ENTER_TRIES=2
RFB_COOKIE_DELAY=0.7
RFB_DOCUMENT_TAB_TRIES=3,4,5
RFB_BEFORE_EMIT_WAIT=1.5

# AUTENTICACAO
OMEGA_JWT_SECRET=troque-esta-chave-por-uma-string-secreta-com-mais-de-32-caracteres
OMEGA_ACCESS_TOKEN_MINUTES=480
OMEGA_ADMIN_NAME=Administrador
OMEGA_ADMIN_EMAIL=admin@omega.local
OMEGA_ADMIN_PASSWORD=Admin@123
OMEGA_RESET_TOKEN_MINUTES=30
OMEGA_RESET_EXPOSE_URL=true
# Para produção, defina OMEGA_RESET_EXPOSE_URL=false e integre envio de e-mail/SMTP.
# DOCUMENTAÇÃO
OMEGA_DOCUMENTO_MAX_MB=25
